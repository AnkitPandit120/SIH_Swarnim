  (footprint "Connector_USB:USB_C_Receptacle_HRO_TYPE-C-31-M-12" (layer "F.Cu")
    (at 50 78)
    (property "Reference" "J7" (at 0 -3) (layer "F.SilkS") (effects (font (size 0.9 0.9) (thickness 0.15))))
    (pad "A1" smd rect (at -3.2 0) (size 0.6 1.2) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND"))
    (pad "A4" smd rect (at -2.4 0) (size 0.6 1.2) (layers "F.Cu" "F.Paste" "F.Mask") (net 3 "+5V"))
    (pad "B4" smd rect (at 2.4 0) (size 0.6 1.2) (layers "F.Cu" "F.Paste" "F.Mask") (net 3 "+5V"))
    (pad "B1" smd rect (at 3.2 0) (size 0.6 1.2) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND"))
  )

  ;; ==================== CRITICAL TRACKS & COPPER ROUTING ====================
  ;; RF 50 Ohm Coplanar Waveguide from SX1276 Pin 9 to SMA J6 Pin 1
  (segment (start 89.5 35.0) (end 95 28) (width 0.5) (layer "F.Cu") (net 18))

  ;; 3.3V Main Power Bus (0.6mm power width)
  (segment (start 36.95 19.3) (end 46.5 30.5) (width 0.6) (layer "F.Cu") (net 2))
  (segment (start 46.5 30.5) (end 46.5 42) (width 0.6) (layer "F.Cu") (net 2))

  ;; SPI Bus (MOSI, MISO, SCK, NSS between ESP32 and SX1276)
  (segment (start 63.5 30.5) (end 74.5 39.0) (width 0.25) (layer "F.Cu") (net 11))
  (segment (start 63.5 32.0) (end 74.5 43.0) (width 0.25) (layer "F.Cu") (net 8))
  (segment (start 63.5 33.5) (end 74.5 41.0) (width 0.25) (layer "F.Cu") (net 10))
  (segment (start 63.5 35.0) (end 74.5 45.0) (width 0.25) (layer "F.Cu") (net 9))

  ;; I2C Bus (SDA, SCL between ESP32, SHT31, DS3231, ADS1115)
  (segment (start 46.5 41.0) (end 26.15 64.25) (width 0.25) (layer "F.Cu") (net 6))
  (segment (start 46.5 42.5) (end 26.15 65.75) (width 0.25) (layer "F.Cu") (net 7))

  ;; ==================== INTERNAL GROUND COPPER ZONE (L2) ====================
  (zone (net 1) (net_name "GND") (layer "In1.Cu") (tstamp 00000000-0000-0000-0000-000000000001)
    (hatch edge 0.5)
    (priority 1)
    (connect_pads yes (clearance 0.25))
    (min_thickness 0.2)
    (filled_polygon
      (pts
        (xy 1 1)
        (xy 99 1)
        (xy 99 79)
        (xy 1 79)
      )
    )
  )

  ;; ==================== INTERNAL POWER COPPER ZONE (L3) ====================
  (zone (net 2) (net_name "+3.3V") (layer "In2.Cu") (tstamp 00000000-0000-0000-0000-000000000002)
    (hatch edge 0.5)
    (priority 1)
    (connect_pads yes (clearance 0.25))
    (min_thickness 0.2)
    (filled_polygon
      (pts
        (xy 1 1)
        (xy 99 1)
        (xy 99 79)
        (xy 1 79)
      )
    )
  )

)
